{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "bun", "filesystem-routing/types"]
  },
  "include": ["src", "vite.config.ts"],
  "tsrx": {
    "compiler": "@tsrx/solid"
  },
  "contentMappers": [
    {
      "package": "@tsrx/content-mapper",
      "extensions": [".tsrx"]
    }
  ]
}
